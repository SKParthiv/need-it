# Comma-separated admin emails for the demo/admin UI (cosmetic gating only —
# real admin enforcement is server-side, backend phase 10).
VITE_ADMIN_EMAILS=you@sastra.ac.in,admin@sastra.ac.in

# Production only: origin of the deployed API (no trailing slash).
# Leave unset in dev — the Vite proxy handles /api locally.
VITE_API_URL=https://needit-api.onrender.com

# Firebase Client Configuration (Firebase Console > Project Settings > General > Your apps)
# Note: These are public client configuration identifiers (not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check — Google Cloud Fraud Defense (reCAPTCHA Enterprise)
# Obtain from Google Cloud Console > Security > Fraud Defense / reCAPTCHA Enterprise
# or Firebase Console > Security > App Check > Apps > reCAPTCHA Enterprise
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_KEY=

# Local Development / CI App Check Debug Token (Optional)
# In dev (npm run dev), if left blank, a token is auto-generated in the browser console.
# Register the generated UUID in Firebase Console > App Check > Apps > Manage debug tokens.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Firebase AI Logic Model (Gemini Developer API)
# Currently featured supported models: 'gemini-3.8-flash' (default), 'gemini-3.5-flash-lite'
VITE_FIREBASE_AI_MODEL=gemini-3.8-flash
