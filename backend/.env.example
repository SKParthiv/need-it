# Copy to .env and fill in. NEVER commit .env. Free/local defaults are fine for dev.
# --- Core ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# --- Postgres ---
POSTGRES_DB=needit
POSTGRES_USER=needit
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# --- Payments: 'manual' for pilot, 'razorpay' once KYC clears ---
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- S3-compatible storage (photos) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- Push (FCM) ---
FCM_SERVER_KEY=
# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
# --- Business rules ---
HELPER_FEE_MIN=20
HELPER_FEE_MAX=50
PAYMENT_TIMEOUT_MINUTES=30
ORDER_VALUE_CAP=2000
