# Copy to .env and fill in. NEVER commit .env. Free/local defaults are fine for dev.
# --- Core ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
COLLEGE_EMAIL_DOMAINS=
PROHIBITED_ITEMS=
# --- Postgres ---
POSTGRES_DB=needit
POSTGRES_USER=needit
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# --- Payments ---
# 'manual' = out-of-band UPI records (default). 'razorpay_base' = merchant of
# record on a base Razorpay account (Payment Links). Route stays RBI-gated.
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret for https://<host>/api/webhooks/payment/
RAZORPAY_WEBHOOK_SECRET=
# --- Email (verification links) ---
# Local default: blank = console backend, register returns the token in the
# API response (pilot mode). Production: SENDGRID_API_KEY (100/day free).
# BREVO_API_KEY also works, but their IP restriction can block cloud hosts.
SENDGRID_API_KEY=
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
# Plain SMTP fallback (local/paid hosts only — Render free blocks port 587):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# --- Google sign-in (primary auth) ---
# Google Auth platform → Clients → Web application client ID. Not a secret.
GOOGLE_CLIENT_ID=
# --- S3-compatible storage (photos) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- Push (FCM) ---
FCM_SERVER_KEY=
# --- Business rules ---
HELPER_FEE_MIN=20
HELPER_FEE_MAX=50
PAYMENT_TIMEOUT_MINUTES=30
ORDER_VALUE_CAP=2000
# --- Photo evidence (Cloudinary free tier) ---
# Blank = uploads disabled (signature endpoint answers 503, UI hides photo button).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=needit-evidence
